<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_feedberry" targetNamespace="http://feedberry/bpmn">
<bpmn:collaboration id="collab"><bpmn:participant id="pool" name="Processo atual de feedback (AS-IS)" processRef="proc"/></bpmn:collaboration>
<bpmn:process id="proc" isExecutable="false">
<bpmn:laneSet id="ls">
<bpmn:lane id="lane_lider" name="Líder / Gestor"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>end1</bpmn:flowNodeRef><bpmn:flowNodeRef>end2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_colab" name="Colaborador"><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Percebe um problema ou um bom trabalho"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t1" name="Chama o colaborador para conversar"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t2" name="Dá o feedback e combina mudanças"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t3" name="Recebe e interpreta o feedback"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g1" name="Registra o feedback?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t4" name="Anota em caderno ou documento"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:task id="t5" name="Guarda só na memória"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t6" name="Tenta aplicar o que entendeu"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:task id="t7" name="Observa o trabalho nos dias seguintes"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g3" name="Lembrou de retomar o assunto?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t8" name="Conversa de novo com o colaborador"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end1" name="Acompanhamento feito"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end2" name="Assunto esquecido"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="t1"/>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="g1"/>
<bpmn:sequenceFlow id="f5" name="Sim" sourceRef="g1" targetRef="t4"/>
<bpmn:sequenceFlow id="f6" name="Não" sourceRef="g1" targetRef="t5"/>
<bpmn:sequenceFlow id="f7" name="" sourceRef="t4" targetRef="g2"/>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t5" targetRef="g2"/>
<bpmn:sequenceFlow id="f9" name="" sourceRef="g2" targetRef="t6"/>
<bpmn:sequenceFlow id="f10" name="" sourceRef="t6" targetRef="t7"/>
<bpmn:sequenceFlow id="f11" name="" sourceRef="t7" targetRef="g3"/>
<bpmn:sequenceFlow id="f12" name="Sim" sourceRef="g3" targetRef="t8"/>
<bpmn:sequenceFlow id="f13" name="Não" sourceRef="g3" targetRef="end2"/>
<bpmn:sequenceFlow id="f14" name="" sourceRef="t8" targetRef="end1"/>
<bpmn:textAnnotation id="ann_D1"><bpmn:text>D1: Feedback reativo, só quando há problema (E1-4, E1-9, E2-4)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D1" sourceRef="start" targetRef="ann_D1"/>
<bpmn:textAnnotation id="ann_D2"><bpmn:text>D2: Sem padrão de canal: presencial, Teams ou mensagem (E1-5, E2-5)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D2" sourceRef="t1" targetRef="ann_D2"/>
<bpmn:textAnnotation id="ann_D7"><bpmn:text>D7: Feedback vago, sem clareza do que mudar (E2-8, E2-10)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D7" sourceRef="t3" targetRef="ann_D7"/>
<bpmn:textAnnotation id="ann_D3"><bpmn:text>D3: Sem registro: muita coisa fica só na memória (E1-6, E2-9)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D3" sourceRef="t5" targetRef="ann_D3"/>
<bpmn:textAnnotation id="ann_D4"><bpmn:text>D4: Sem histórico único para consultar (E1-8, E2-6)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D4" sourceRef="g2" targetRef="ann_D4"/>
<bpmn:textAnnotation id="ann_D6"><bpmn:text>D6: Sem retorno para saber se melhorou (E2-7, E2-8)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D6" sourceRef="t6" targetRef="ann_D6"/>
<bpmn:textAnnotation id="ann_D5"><bpmn:text>D5: Esquecer de retomar o combinado (E1-7, E1-10, E2-9)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_D5" sourceRef="g3" targetRef="ann_D5"/>
</bpmn:process>
